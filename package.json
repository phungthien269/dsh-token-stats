{
  "name": "dsh-token-stats",
  "description": "Token usage dashboard for the DeepSeek Harness web GUI: today / week / month totals, per-model breakdown, 30-day chart, and a built-in 4-language UI (vi/en/zh/ja). Read-only over the Wallet ledger.",
  "version": "0.2.1",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "token-usage",
    "token-stats",
    "i18n",
    "dashboard"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check lib/client.js",
    "test": "node --test test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phungthien269/dsh-token-stats.git"
  },
  "homepage": "https://github.com/phungthien269/dsh-token-stats#readme",
  "bugs": {
    "url": "https://github.com/phungthien269/dsh-token-stats/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
